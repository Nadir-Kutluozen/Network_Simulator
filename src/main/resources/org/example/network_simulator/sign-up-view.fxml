<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.network_simulator.Controllers.SignUpController">
   <children>
      <ImageView fitHeight="532.0" fitWidth="565.0" layoutX="209.0" layoutY="27.0" opacity="0.15" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/bigdata.png" />
         </image>
      </ImageView>
      <TextField fx:id="usernameField" alignment="CENTER" layoutX="336.0" layoutY="217.0" prefHeight="37.0" prefWidth="276.0" promptText="Username" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </TextField>
      <DatePicker fx:id="dobField" layoutX="337.0" layoutY="367.0" prefHeight="37.0" prefWidth="276.0" promptText="        Date of Birth" style="-fx-border-radius: 20;" />
      <TextField fx:id="emailField" alignment="CENTER" layoutX="337.0" layoutY="267.0" prefHeight="37.0" prefWidth="276.0" promptText="Email" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </TextField>
      <PasswordField fx:id="passwordField" alignment="CENTER" layoutX="337.0" layoutY="318.0" prefHeight="37.0" prefWidth="276.0" promptText="Password" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </PasswordField>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="400.0" layoutY="48.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/profile.png" />
         </image>
         <effect>
            <DropShadow offsetY="10.0" />
         </effect>
      </ImageView>
      <Button fx:id="signInButton" alignment="CENTER" contentDisplay="CENTER" layoutX="432.0" layoutY="494.0" mnemonicParsing="false" onAction="#onSignInClick" style="-fx-background-color: linear-gradient(to top, lightgreen, cadetblue); -fx-border-radius: 100; -fx-border-image-width: 2; -fx-border-color: black; -fx-background-radius: 100;" text="Sign In" textFill="WHITE">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="18.0" />
         </font>
      </Button>
      <Button fx:id="signUpButton" alignment="CENTER" contentDisplay="CENTER" layoutX="429.0" layoutY="415.0" mnemonicParsing="false" onAction="#onSignUpClick" style="-fx-background-color: linear-gradient(to top, lightgreen, cadetblue); -fx-border-radius: 100; -fx-border-image-width: 2; -fx-border-color: black; -fx-background-radius: 100;" text="Sign Up" textFill="WHITE">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Text layoutX="460.0" layoutY="483.0" strokeType="OUTSIDE" strokeWidth="0.0" text="OR">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Text>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.network_simulator.Controllers.SignUpController">
   <children>
      <ImageView fitHeight="492.0" fitWidth="624.0" layoutX="229.0" layoutY="67.0" opacity="0.15" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/bigdata.png" />
         </image>
      </ImageView>
      <TextField fx:id="usernameField" alignment="CENTER" layoutX="336.0" layoutY="237.0" prefHeight="37.0" prefWidth="276.0" promptText="Username" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </TextField>
      <TextField fx:id="emailField" alignment="CENTER" layoutX="336.0" layoutY="289.0" prefHeight="37.0" prefWidth="276.0" promptText="Email" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </TextField>
      <PasswordField fx:id="passwordField" alignment="CENTER" layoutX="337.0" layoutY="342.0" prefHeight="37.0" prefWidth="276.0" promptText="Password" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </PasswordField>
      <Button fx:id="signInButton" layoutX="433.0" layoutY="483.0" mnemonicParsing="false" onAction="#onSignInClick" style="-fx-background-color: linear-gradient(to top, green, dodgerblue); -fx-border-radius: 100; -fx-border-image-width: 2; -fx-border-color: black; -fx-background-radius: 100;" text="Sign In">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="18.0" />
         </font>
      </Button>
      <Button fx:id="signUpButton" layoutX="431.0" layoutY="392.0" mnemonicParsing="false" onAction="#onSignUpClick" style="-fx-background-color: linear-gradient(to top, green, dodgerblue); -fx-border-radius: 100; -fx-border-image-width: 2; -fx-border-color: black; -fx-background-radius: 100;" text="Sign Up">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="18.0" />
         </font>
      </Button>
      <Text layoutX="460.0" layoutY="466.0" strokeType="OUTSIDE" strokeWidth="0.0" text="OR">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Text>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="400.0" layoutY="67.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/profile.png" />
         </image>
         <effect>
            <DropShadow offsetX="-5.0" offsetY="10.0" />
         </effect>
      </ImageView>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.network_simulator.Controllers.LoginController">
   <children>
      <ImageView fitHeight="532.0" fitWidth="565.0" layoutX="209.0" layoutY="27.0" opacity="0.15" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/bigdata.png" />
         </image>
      </ImageView>
      <TextField fx:id="userName" alignment="CENTER" layoutX="336.0" layoutY="237.0" prefHeight="37.0" prefWidth="276.0" promptText="Username" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </TextField>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="400.0" layoutY="48.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/profile.png" />
         </image>
         <effect>
            <DropShadow offsetY="10.0" />
         </effect>
      </ImageView>
      <Button fx:id="signInButton" alignment="CENTER" contentDisplay="CENTER" layoutX="431.0" layoutY="366.0" mnemonicParsing="false" onAction="#onSignInClick" style="-fx-background-color: linear-gradient(to top, green, dodgerblue); -fx-border-radius: 100; -fx-border-image-width: 2; -fx-border-color: black; -fx-background-radius: 100;" text="Sign In" textFill="WHITE">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Text layoutX="459.0" layoutY="443.0" strokeType="OUTSIDE" strokeWidth="0.0" text="OR">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Text>
      <Button fx:id="signUpButton" alignment="CENTER" contentDisplay="CENTER" layoutX="430.0" layoutY="460.0" mnemonicParsing="false" onAction="#onSignUpClick" style="-fx-background-color: linear-gradient(to top, green, dodgerblue); -fx-border-radius: 100; -fx-border-image-width: 2; -fx-border-color: black; -fx-background-radius: 100;" text="Sign Up" textFill="WHITE">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="18.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <PasswordField fx:id="passwordField" alignment="CENTER" layoutX="335.0" layoutY="300.0" prefHeight="37.0" prefWidth="276.0" promptText="Password" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </PasswordField>
   </children>
</AnchorPane>

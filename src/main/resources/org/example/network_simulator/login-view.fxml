<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.network_simulator.Controllers.LoginController">
   <children>
      <ImageView fitHeight="492.0" fitWidth="624.0" layoutX="229.0" layoutY="67.0" opacity="0.15" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/bigdata.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="400.0" layoutY="67.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/profile.png" />
         </image>
         <effect>
            <DropShadow offsetX="-5.0" offsetY="10.0" />
         </effect>
      </ImageView>
      <TextField fx:id="userName" alignment="CENTER" layoutX="337.0" layoutY="244.0" prefHeight="37.0" prefWidth="276.0" promptText="Username" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </TextField>
      <TextField fx:id="passwordField" alignment="CENTER" layoutX="337.0" layoutY="294.0" prefHeight="37.0" prefWidth="276.0" promptText="Password" style="-fx-background-radius: 100;">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </TextField>
      <Button fx:id="signInButton" alignment="CENTER" contentDisplay="CENTER" layoutX="435.0" layoutY="405.0" mnemonicParsing="false" onAction="#onSignInClick" style="-fx-background-color: linear-gradient(to top, cadetblue, grey); -fx-border-radius: 100; -fx-border-image-width: 2; -fx-border-color: black; -fx-background-radius: 100;" text="Sign In">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="18.0" />
         </font>
      </Button>
      <Button fx:id="signUpButton" alignment="CENTER" contentDisplay="CENTER" layoutX="431.0" layoutY="457.0" mnemonicParsing="false" onAction="#onSignUpClick" style="-fx-background-color: linear-gradient(to top, cadetblue, grey); -fx-border-radius: 100; -fx-border-image-width: 2; -fx-border-color: black; -fx-background-radius: 100;" text="Sign Up">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="18.0" />
         </font>
      </Button>
      <Text layoutX="467.0" layoutY="368.0" strokeType="OUTSIDE" strokeWidth="0.0" text="OR">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Text>
   </children>
</AnchorPane>

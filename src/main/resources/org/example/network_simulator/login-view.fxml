            <Image url="@profile.png" />
         </image>
      </ImageView>
      <TextField layoutX="336.0" layoutY="237.0" prefHeight="37.0" prefWidth="276.0" text="                         Username">
         <font>
            <Font name="IBM Plex Sans Arabic SmBld" size="16.0" />
         </font>
      </TextField>
      <TextField layoutX="336.0" layoutY="307.0" prefHeight="37.0" prefWidth="276.0" text="                         Password">

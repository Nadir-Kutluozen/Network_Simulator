<AnchorPane prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.network_simulator.LoginController">
   <children>
      <ImageView fitHeight="492.0" fitWidth="624.0" layoutX="229.0" layoutY="54.0" opacity="0.45" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@bigdata.png" />
         </image>
      </ImageView>
      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="400.0" layoutY="37.0" pickOnBounds="true" preserveRatio="true">
